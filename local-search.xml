86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>        </div>      </div>    </div>    <div class="progress-container" id="progressContainer">      <div class="progress-bar" id="progressBar"><div class="progress-handle" id="progressHandle"></div></div>    </div>  </div></div>]]></content>
    
    
